{
  "name": "eco-school",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:demo": "cross-env NEXT_PUBLIC_DEMO=1 DEMO_EXPORT=1 next build",
    "build:cf": "cross-env STATIC_EXPORT=1 next build && node scripts/cf-postbuild.mjs",
